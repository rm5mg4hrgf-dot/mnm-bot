# ======================================================================
# MediNeuroMatics (MNM) Discord bot: configuration template
# Copy this file to ".env" and fill in your real values.
# NEVER commit ".env". On FadeHost, enter these in the environment-variable
# settings instead of uploading a .env file.
# ======================================================================

# --- REQUIRED -----------------------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=Redacted
# Server (guild) ID: Discord -> Settings -> Advanced -> Developer Mode, then right-click the server -> Copy Server ID
