# Role whose members can use admin commands (right-click role -> Copy Role ID)
ADMIN_ROLE_ID=1561019403498168361

# --- OPENAI (needed for /ask and Proof Forge; the bot runs without it) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=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
# A current model from https://platform.openai.com/docs/models that your account can use.
