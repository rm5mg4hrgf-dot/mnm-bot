# ======================================================================
# MediNeuroMatics (MNM) Discord bot: configuration template
# Copy this file to ".env" and fill in your real values.
# NEVER commit ".env". On FadeHost, enter these in the environment-variable
# settings instead of uploading a .env file.
# ======================================================================

# --- REQUIRED -----------------------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
# Server (guild) ID: Discord -> Settings -> Advanced -> Developer Mode, then right-click the server -> Copy Server ID
GUILD_ID=YOUR_DISCORD_SERVER_ID
# Role whose members can use admin commands (right-click role -> Copy Role ID)
ADMIN_ROLE_ID=YOUR_ADMIN_ROLE_ID

# --- OPENAI (needed for /ask and Proof Forge; the bot runs without it) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
# A current model from https://platform.openai.com/docs/models that your account can use.
OPENAI_MODEL=YOUR_SUPPORTED_MODEL_NAME

# --- CHANNELS (right-click channel/category -> Copy Channel ID) -----------
WELCOME_CHANNEL_ID=YOUR_WELCOME_CHANNEL_ID
LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID
TICKET_CATEGORY_ID=YOUR_TICKET_CATEGORY_ID
SHOWCASE_CHANNEL_ID=YOUR_SHOWCASE_CHANNEL_ID

# --- OPTIONAL (delete the leading # to use) ------------------------------
# MODERATOR_ROLE_ID=YOUR_MODERATOR_ROLE_ID
# RULES_CHANNEL_ID=YOUR_RULES_CHANNEL_ID
# TRACKS_CHANNEL_ID=YOUR_TRACKS_CHANNEL_ID
# DATABASE_PATH=data/runtime/mnm.db        # point at persistent storage on your host
# LOG_LEVEL=INFO
# AI cost controls (defaults shown)
# AI_TIMEOUT_SECONDS=45
# AI_MAX_OUTPUT_TOKENS=1200
# AI_MAX_INPUT_CHARS=1500
# AI_USER_COOLDOWN_SECONDS=20
# AI_USER_DAILY_LIMIT=20
# AI_GLOBAL_DAILY_LIMIT=400
